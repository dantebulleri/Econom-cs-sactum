# ─── Economist Sanctum — Variables de entorno ───────────────────────────────
#
# Copiá este archivo como .env.local para desarrollo local:
#   cp .env.example .env.local
#
# Para deploy en Vercel, configurá estas variables en:
#   Settings → Environment Variables

# REQUERIDO: API key de OpenAI para todos los módulos de IA
OPENAI_API_KEY=sk-...

# Base de datos (SQLite local por defecto, cambiar para producción)
DATABASE_URL="file:./dev.db"
